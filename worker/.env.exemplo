# ==========================================================
# Configuração do Robô de Lances (roda no PC do escritório)
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA suba o arquivo .env preenchido para o GitHub!
# ==========================================================

# --- Conexão com o Supabase (mesmo do CRM) ---
# Pegue em: Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=cole_aqui_a_chave

# --- Newcon (site newkey.cny.com.br) ---
NEWCON_URL=https://newkey.cny.com.br/Intranet/frmCorCCCnsLogin.aspx?applicationKey=8OFJREgjYzkCXpyH6PzwcUAVvR1wMi02Pg/Arnt4d1tvmwE4G5ciEwucLo7lnSDEcEMRq2sjRhV0bdTJu+fOlX3qHSZ6qRQB19PxnBI+WPSMmve26KYP8g==

# O robô pega login e senha do Newcon do COFRE DE SENHAS do CRM (menu "Senhas").
# Aqui vai só o nome da empresa cadastrada lá, para o robô saber qual linha ler.
NEWCON_EMPRESA_COFRE=YAMAHA NEWCON

# (Opcional) Reserva: se o robô não achar a senha no cofre, usa estas.
# Deixe em branco para usar SÓ o cofre.
NEWCON_LOGIN=
NEWCON_SENHA=

# --- Comportamento do robô ---
# MODO_SIMULACAO=true  -> NÃO abre o Newcon; só finge que ofertou (para testar o circuito CRM<->fila)
# MODO_SIMULACAO=false -> abre o Newcon de verdade (só use depois da gravação do fluxo)
MODO_SIMULACAO=true

# Mostrar a janela do navegador (true) ou rodar invisível (false)
NAVEGADOR_VISIVEL=true

# Segundos entre cada varredura da fila
INTERVALO_SEGUNDOS=15

# Tempo máximo (segundos) para esperar a mensagem de confirmação do Newcon (a "trava de segurança")
TIMEOUT_CONFIRMACAO=120

# Pausa (segundos) ANTES de clicar em Confirmar, para você conferir a tela na 1ª vez.
# Recomendo 10 nas primeiras execuções; depois volte para 0.
PAUSA_ANTES_CONFIRMAR_SEG=0

# Pasta onde os PDFs dos BOLETOS serão salvos (no PC do escritório)
PASTA_BOLETOS=G:\Meu Drive\CONSORBENS\IMAGENS\Boletos
